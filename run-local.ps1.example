# Local dev credentials - DO NOT COMMIT
#
# run-local.ps1 is deliberately in .gitignore, so it does not come with the repository.
# Copy this file to run-local.ps1, fill in your own values, then run: .\run-local.ps1
#
# The application compiles in no credentials. It reads them from the environment, and
# run-with-db.ps1 sets these variables before launching:
#
#   HELLOWORLD_DB_PASSWORD           required - no default. Startup is blocked without it.
#   HELLOWORLD_DB_SERVER             optional - defaults to BEELINK
#   HELLOWORLD_DB_USER               optional - defaults to sa
#   HELLOWORLD_DB_NAME               optional - defaults to WX_Framework
#   HELLOWORLD_DB_ENCRYPT            optional - defaults to False
#   HELLOWORLD_DB_TRUST_SERVER_CERT  optional - defaults to True
#
# On a server, or anywhere the defaults above are wrong, set HELLOWORLD_DB_CONNECTION to a
# full connection string instead. It takes precedence over every variable listed above, so
# a wrong server name cannot be picked up silently from a default.
#
# With none of this configured the application shows "Database Configuration Required" at
# startup and exits with code 2, before the login screen.
#
# See DataAccess.BuildConnectionString and DataAccess.GetMissingConfigurationMessage.

param(
	[switch]$Preview
)

$Server   = "BEELINK"
$User     = "SA"
$Password = "<your password here>"
$Database = "WX_Framework"

.\run-with-db.ps1 -Server $Server -User $User -Password $Password -Database $Database -Preview:$Preview
