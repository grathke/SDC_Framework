<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the application: it is a WinForms project, and some tested types
         (ComboBox, for one) come from System.Windows.Forms. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Empty: the application declares its full name in each file (SDC.Framework) with an empty
         root namespace, so the tests do the same. Leaving this set would stack a second
         segment in front of Namespace SDC.Framework.Tests. -->
    <RootNamespace></RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SDC.Framework.vbproj" />
  </ItemGroup>

</Project>
