<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="**/*.resx" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dashboard and menu icons are loaded from disk at runtime, not embedded, so one copy beside
         the exe serves every application in the folder and a picture can be replaced without a
         rebuild. Without this the images stay in the source tree and a deployed exe finds none. -->
    <Content Include="assets\images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="project-backup/**" />
    <EmbeddedResource Remove="project-backup/**" />
    <None Remove="project-backup/**" />
    <Compile Remove="restore-points/**" />
    <EmbeddedResource Remove="restore-points/**" />
    <None Remove="restore-points/**" />
    <!-- The test project lives under the repository root, which this project globs. Without
         these it would compile the tests into the application. -->
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
