bin/
obj/
.vs/
*.user
*.suo
*.cache
*.tmp
project-backup/
run-local.ps1

# Test build output
tests/**/bin/
tests/**/obj/

# Local safety snapshots. Some contain an old run-local.ps1 with a real password,
# so they stay on disk and out of history.
restore-points/

# Saved layout previews - generated images, not source
previews/

# Personal Claude Code settings - machine-specific permissions, not shared
.claude/settings.local.json

# Database backups. A .bak of WX_Framework carries everything the seed scripts exclude -
# password hashes, TOTP keys, the Smarty API credentials, and every client's data - and it
# is handed over out of band, never through git.
*.bak
